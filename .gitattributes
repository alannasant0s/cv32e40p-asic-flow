# Fim de linha: LF em tudo. Editores no Windows não podem converter no checkout.
* text=auto eol=lf

# Scripts que rodam no servidor Linux nunca podem carregar CRLF.
*.sh    text eol=lf
*.tcl   text eol=lf
*.py    text eol=lf
*.sdc   text eol=lf
*.sv    text eol=lf
*.svh   text eol=lf
*.v     text eol=lf
*.vh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.flist text eol=lf
*.f     text eol=lf
Makefile text eol=lf

# Artefatos binários que podem legitimamente viver em results/ ou verif/sw/.
*.png     binary
*.jpg     binary
*.svg     text eol=lf
*.parquet binary
*.hex     text eol=lf
*.elf     binary
*.bin     binary
